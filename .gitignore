# This .gitignore file is placed at the root of the repository.
# Unity project is located in: AgentesAIUnity/
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

# Temporary files
/AgentesAIUnity/.utmp/

# Unity generated folders
/AgentesAIUnity/[Ll]ibrary/
/AgentesAIUnity/[Tt]emp/
/AgentesAIUnity/[Oo]bj/
/AgentesAIUnity/[Bb]uild/
/AgentesAIUnity/[Bb]uilds/
/AgentesAIUnity/[Ll]ogs/
/AgentesAIUnity/[Uu]ser[Ss]ettings/
/AgentesAIUnity/[Mm]emoryCaptures/
/AgentesAIUnity/[Rr]ecordings/

# Log files
*.log

# Blender backup files
*.blend1
*.blend1.meta

# Asset Store Tools plugin (uncomment if needed)
# /AgentesAIUnity/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/AgentesAIUnity/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated IDE solution and project files
/AgentesAIUnity/ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt
mono_crash.*

# Build packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated files
crashlytics-build.properties

# TestRunner generated files
/AgentesAIUnity/InitTestScene*.unity*

# Addressables generated files
/AgentesAIUnity/ServerData/
/AgentesAIUnity/[Aa]ssets/StreamingAssets/aa*
/AgentesAIUnity/[Aa]ssets/AddressableAssetsData/link.xml*
/AgentesAIUnity/[Aa]ssets/Addressables_Temp*
/AgentesAIUnity/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated files
/AgentesAIUnity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/AgentesAIUnity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/AgentesAIUnity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/AgentesAIUnity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Play Mode test scenes
/AgentesAIUnity/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit generated files
/AgentesAIUnity/UIElementsSchema/

# Auto-generated cache in Assets
